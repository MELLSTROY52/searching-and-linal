FILE_DESCRIPTION=OpenXLSX: GNU Makefile for installed demos
FILE_VERSION=2026-09-04 13:00 CEST
# SPDX-License-Identifier: BSD-3-Clause
# SPDX-FileCopyrightText: Copyright (c) 2026, Lars Uffmann <coding23@uffmann.name>
#

$(info $(FILE_DESCRIPTION) ($(FILE_VERSION)))
$(info )

### BEGIN Makefile options ###
	# invoking Makefile with make OPENXLSX_ENABLE_LIBZIP_EXAMPLE=ON triggers build of Demo1A
	OPENXLSX_ENABLE_LIBZIP_EXAMPLE?=OFF
	# NOTE: make Demo1A and make all will both also build Demo1A
### END Makefile options ###


### BEGIN tools for text substitution ###
#  call tools like so:
#    VAR = MixedCaseText
#    LOWER_VAR = $(call lc,$(VAR))
#
# lc: create all lowercase variable:
lc = $(subst A,a,$(subst B,b,$(subst C,c,$(subst D,d,$(subst E,e,$(subst F,f,$(subst G,g,$(subst H,h,$(subst I,i,$(subst J,j,$(subst K,k,$(subst L,l,$(subst M,m,$(subst N,n,$(subst O,o,$(subst P,p,$(subst Q,q,$(subst R,r,$(subst S,s,$(subst T,t,$(subst U,u,$(subst V,v,$(subst W,w,$(subst X,x,$(subst Y,y,$(subst Z,z,$1))))))))))))))))))))))))))
#
# uc: create all uppercase variable:
uc = $(subst a,A,$(subst b,B,$(subst c,C,$(subst d,D,$(subst e,E,$(subst f,F,$(subst g,G,$(subst h,H,$(subst i,I,$(subst j,J,$(subst k,K,$(subst l,L,$(subst m,M,$(subst n,N,$(subst o,O,$(subst p,P,$(subst q,Q,$(subst r,R,$(subst s,S,$(subst t,T,$(subst u,U,$(subst v,V,$(subst w,W,$(subst x,X,$(subst y,Y,$(subst z,Z,$1))))))))))))))))))))))))))
#
### END tools for text substitution   ###


### Evaluate Makefile option OPENXLSX_ENABLE_LIBZIP_EXAMPLE to trigger build of Demo1A ###
ifeq ("$(call lc,$(OPENXLSX_ENABLE_LIBZIP_EXAMPLE))", "on")
	BUILD_DEMO1A=ON
else
	BUILD_DEMO1A=OFF

	### Determine whether target all or target Demo1A was invoked as fallback triggers for echo output of "Building custom zip example Demo1A"
	TARGET_ALL_MATCH    := $(filter all, $(MAKECMDGOALS))
	TARGET_DEMO1A_MATCH := $(filter Demo1A, $(MAKECMDGOALS))
	ifneq ($(TARGET_ALL_MATCH),)            # target all was explicitly invoked
		BUILD_DEMO1A_ECHO=ON
	else ifneq ($(TARGET_DEMO1A_MATCH),)    # target Demo1A was explicitly invoked
		BUILD_DEMO1A_ECHO=ON
	else                                    # else: Demo1A configuration shall not be echoed as it will not be built
		BUILD_DEMO1A_ECHO=OFF
	endif
endif


### Configure project targets ###
TARGETS=Demo1 Demo2 Demo3 Demo4 Demo5 Demo6 Demo7 Demo8 Demo9 Demo10
ADDITIONAL_TARGETS=Demo1A
ifeq ("$(BUILD_DEMO1A)", "ON")
	DEFAULT_TARGETS=$(TARGETS) $(ADDITIONAL_TARGETS)
else
	DEFAULT_TARGETS=$(TARGETS)
endif


### Configure project build directories ###
DEMOS_SRC_DIR=.
BIN_DIR=gnu-make-build

$(info Building OpenXLSX Examples in $(BIN_DIR)/)
$(info )

CC=gcc
CXX=g++

OPTIMIZATION_FLAGS=

SRC_DIR=.
INCLUDE_DIR=.
OBJ_DIR=$(BIN_DIR)/obj


### Configure application objects ###

# NOTE: Demo0 is a placeholder for test programs - if used, has to be explicitly provided as build target (not included in defaults)
OBJS_DEMO0=Demo0.o
OBJS_OPENXLSX_DEMO0=
LDLIBS_DEMO0=

OBJS_DEMO1=Demo1.o
OBJS_OPENXLSX_DEMO1=
LDLIBS_DEMO1=

OBJS_DEMO1A=Demo1A.o
OBJS_OPENXLSX_DEMO1A=
LDLIBS_DEMO1A=-lzip

OBJS_DEMO2=Demo2.o
OBJS_OPENXLSX_DEMO2=
LDLIBS_DEMO2=

OBJS_DEMO3=Demo3.o
OBJS_OPENXLSX_DEMO3=
LDLIBS_DEMO3=

OBJS_DEMO4=Demo4.o
OBJS_OPENXLSX_DEMO4=
LDLIBS_DEMO4=

OBJS_DEMO5=Demo5.o
OBJS_OPENXLSX_DEMO5=
LDLIBS_DEMO5=

OBJS_DEMO6=Demo6.o
OBJS_OPENXLSX_DEMO6=
LDLIBS_DEMO6=

OBJS_DEMO7=Demo7.o
OBJS_OPENXLSX_DEMO7=
LDLIBS_DEMO7=

OBJS_DEMO8=Demo8.o
OBJS_OPENXLSX_DEMO8=
LDLIBS_DEMO8=

OBJS_DEMO9=Demo9.o
OBJS_OPENXLSX_DEMO9=
LDLIBS_DEMO9=

OBJS_DEMO10=Demo10.o
OBJS_OPENXLSX_DEMO10=
LDLIBS_DEMO10=


### Configure generic g++ compiler and linker flags ###
SANITIZE_FLAGS=
SANITIZE_LIBS=

ENABLED_WARNING_FLAGS=-Wformat -Wformat-signedness -Wall -Wpedantic -Wextra
DISABLED_WARNING_FLAGS=

GENERIC_FLAGS=$(PROJECT_FLAGS) -fno-common $(SANITIZE_FLAGS) $(OPTIMIZATION_FLAGS) $(ENABLED_WARNING_FLAGS) $(DISABLED_WARNING_FLAGS)

CPPFLAGS=$(GENERIC_FLAGS) -std=c++17
LDFLAGS=$(SANITIZE_FLAGS)

### The main project's cmake configure_file will set PKG_CONFIG_STATIC_FLAG based on BUILD_SHARED_LIBS
PKG_CONFIG_STATIC_FLAG=--static

### Get OpenXLSX compiler and linker flags from pkg-config ###
OPENXLSX_CFLAGS=`pkg-config --cflags OpenXLSX`
OPENXLSX_LDLIBS=`pkg-config $(PKG_CONFIG_STATIC_FLAG) --libs OpenXLSX`


### Target rules ###

# gnu make override to define the default make directive, only takes a single target
.DEFAULT_GOAL := default
default: $(DEFAULT_TARGETS)

all: $(TARGETS) $(ADDITIONAL_TARGETS)

# the $(NOOP) rules are only needed for the dependency / forward to $(BIN_DIR)
Demo0: $(BIN_DIR)/Demo0
	$(NOOP)
Demo1: $(BIN_DIR)/Demo1
	$(NOOP)
Demo1A: $(BIN_DIR)/Demo1A
	$(NOOP)
Demo2: $(BIN_DIR)/Demo2
	$(NOOP)
Demo3: $(BIN_DIR)/Demo3
	$(NOOP)
Demo4: $(BIN_DIR)/Demo4
	$(NOOP)
Demo5: $(BIN_DIR)/Demo5
	$(NOOP)
Demo6: $(BIN_DIR)/Demo6
	$(NOOP)
Demo7: $(BIN_DIR)/Demo7
	$(NOOP)
Demo8: $(BIN_DIR)/Demo8
	$(NOOP)
Demo9: $(BIN_DIR)/Demo9
	$(NOOP)
Demo10: $(BIN_DIR)/Demo10
	$(NOOP)

# complex rule for BIN_DIR targets: include objects from OBJS_<target> and libraries from LDLIBS_<target>
.SECONDEXPANSION:
$(BIN_DIR)/%: $$(addprefix $(OBJ_DIR)/,$$(OBJS_$$(call uc,$$*))) $$(OBJS_OPENXLSX_$$(call uc,$$*)) | $(BIN_DIR)
	$(CXX) $(LDFLAGS) $^ $(OPENXLSX_LDLIBS) $(LDLIBS_$(call uc,$*)) -o $@

# rule for .cpp files in DEMOS_SRC_DIR
$(OBJ_DIR)/%.o: $(addprefix $(DEMOS_SRC_DIR)/,%.cpp) | $(OBJ_DIR)
	$(CXX) $(CPPFLAGS) $(OPENXLSX_CFLAGS) -c $< -o $@

# create BIN_DIR if not existing
$(BIN_DIR):
	mkdir $@

# create OBJ_DIR if not existing
$(OBJ_DIR): | $(BIN_DIR)
	mkdir $@

# .SECONDARY with no prerequisites causes all targets to be treated
# as secondary (i.e., no target is removed because it is considered
# intermediate).
.SECONDARY:

# indicate all rules without target output
.PHONY: default all clean cleanObjects cleanTargets echo

clean: cleanObjects cleanTargets

cleanObjects:
	rm -f $(addprefix $(OBJ_DIR)/,$(OBJS_DEMO0) $(OBJS_DEMO1) $(OBJS_DEMO2) $(OBJS_DEMO3) $(OBJS_DEMO4) $(OBJS_DEMO5) $(OBJS_DEMO6) $(OBJS_DEMO7) $(OBJS_DEMO8) $(OBJS_DEMO9) $(OBJS_DEMO10)) \
	      $(addprefix $(OBJ_DIR)/,$(OBJS_DEMO1A))
	find $(OBJ_DIR) -depth -type d -delete >/dev/null 2>&1 || true

cleanTargets:
	rm -f $(addprefix $(BIN_DIR)/,Demo0) $(addprefix $(BIN_DIR)/,$(TARGETS)) $(addprefix $(BIN_DIR)/,$(ADDITIONAL_TARGETS))


### (special target) Have a look at the established configuration ###
echo:
	@echo "OpenXLSX Demos Makefile"
	@echo "----------------------------------------------"
	@echo "Make options:"
	@echo "  OPENXLSX_ENABLE_LIBZIP_EXAMPLE:  $(OPENXLSX_ENABLE_LIBZIP_EXAMPLE)"
	@echo
	@echo "Resulting Makefile flags:"
	@echo "  BUILD_DEMO1A:                    $(BUILD_DEMO1A)"
	@echo
	@echo "TARGETS:         $(TARGETS)"
	@echo "ADDITIONAL_TARGETS: $(ADDITIONAL_TARGETS)"
	@echo "DEFAULT_TARGETS: $(DEFAULT_TARGETS)"
	@echo "DEMOS_SRC_DIR: $(DEMOS_SRC_DIR)"
	@echo "BIN_DIR: $(BIN_DIR)"
	@echo
	@echo "CC    : $(CC)"
	@echo "CXX   : $(CXX)"
	@echo
	@echo "PKG_CONFIG_STATIC_FLAG: $(PKG_CONFIG_STATIC_FLAG)"
	@echo "OPENXLSX_CFLAGS: $(OPENXLSX_CFLAGS)"
	@echo "OPENXLSX_LDLIBS: $(OPENXLSX_LDLIBS)"
	@echo
	@echo "OPTIMIZATION_FLAGS: $(OPTIMIZATION_FLAGS)"
	@echo
	@echo "SANITIZE_FLAGS: $(SANITIZE_FLAGS)"
	@echo "SANITIZE_LIBS: $(SANITIZE_LIBS)"
	@echo "DISABLED_WARNING_FLAGS: $(DISABLED_WARNING_FLAGS)"
	@echo "GENERIC_FLAGS: $(GENERIC_FLAGS)"
	@echo "CPPFLAGS: $(CPPFLAGS)"
	@echo
	@echo "LDFLAGS: $(LDFLAGS)"
	@echo "LDLIBS: $(LDLIBS)"
	@echo
	@echo "OpenXLSX Demos project configuration:"
	@echo "-------------------------------"
	@echo "SRC_DIR: $(SRC_DIR)"
	@echo "INCLUDE_DIR: $(INCLUDE_DIR)"
	@echo "OBJ_DIR: $(OBJ_DIR)"
	@echo
	@echo "OBJS_DEMO0: $(OBJS_DEMO0)"
	@echo "OBJS_OPENXLSX_DEMO0: $(OBJS_OPENXLSX_DEMO0)"
	@echo "LDLIBS_DEMO0: $(LDLIBS_DEMO0)"
	@echo "OBJS_DEMO1: $(OBJS_DEMO1)"
	@echo "OBJS_OPENXLSX_DEMO1: $(OBJS_OPENXLSX_DEMO1)"
	@echo "LDLIBS_DEMO1: $(LDLIBS_DEMO1)"
	@echo "OBJS_DEMO2: $(OBJS_DEMO2)"
	@echo "OBJS_OPENXLSX_DEMO2: $(OBJS_OPENXLSX_DEMO2)"
	@echo "LDLIBS_DEMO2: $(LDLIBS_DEMO2)"
	@echo "OBJS_DEMO3: $(OBJS_DEMO3)"
	@echo "OBJS_OPENXLSX_DEMO3: $(OBJS_OPENXLSX_DEMO3)"
	@echo "LDLIBS_DEMO3: $(LDLIBS_DEMO3)"
	@echo "OBJS_DEMO4: $(OBJS_DEMO4)"
	@echo "OBJS_OPENXLSX_DEMO4: $(OBJS_OPENXLSX_DEMO4)"
	@echo "LDLIBS_DEMO4: $(LDLIBS_DEMO4)"
	@echo "OBJS_DEMO5: $(OBJS_DEMO5)"
	@echo "OBJS_OPENXLSX_DEMO5: $(OBJS_OPENXLSX_DEMO5)"
	@echo "LDLIBS_DEMO5: $(LDLIBS_DEMO5)"
	@echo "OBJS_DEMO6: $(OBJS_DEMO6)"
	@echo "OBJS_OPENXLSX_DEMO6: $(OBJS_OPENXLSX_DEMO6)"
	@echo "LDLIBS_DEMO6: $(LDLIBS_DEMO6)"
	@echo "OBJS_DEMO7: $(OBJS_DEMO7)"
	@echo "OBJS_OPENXLSX_DEMO7: $(OBJS_OPENXLSX_DEMO7)"
	@echo "LDLIBS_DEMO7: $(LDLIBS_DEMO7)"
	@echo "OBJS_DEMO8: $(OBJS_DEMO8)"
	@echo "OBJS_OPENXLSX_DEMO8: $(OBJS_OPENXLSX_DEMO8)"
	@echo "LDLIBS_DEMO8: $(LDLIBS_DEMO8)"
	@echo "OBJS_DEMO9: $(OBJS_DEMO9)"
	@echo "OBJS_OPENXLSX_DEMO9: $(OBJS_OPENXLSX_DEMO9)"
	@echo "LDLIBS_DEMO9: $(LDLIBS_DEMO9)"
	@echo "OBJS_DEMO10: $(OBJS_DEMO10)"
	@echo "OBJS_OPENXLSX_DEMO10: $(OBJS_OPENXLSX_DEMO10)"
	@echo "LDLIBS_DEMO10: $(LDLIBS_DEMO10)"
	@if [ "$(BUILD_DEMO1A)" = "ON" -o "$(BUILD_DEMO1A_ECHO)" = "ON" ]; then \
		echo ""; \
		echo "Building custom zip example Demo1A"; \
		echo "  OBJS_DEMO1A: $(OBJS_DEMO1A)"; \
		echo "  OBJS_OPENXLSX_DEMO1A: $(OBJS_OPENXLSX_DEMO1A)"; \
		echo "  LDLIBS_DEMO1A: $(LDLIBS_DEMO1A)"; \
	fi
